# Network Configuration
# ローカルネットワークのIPアドレス（スマホアクセス用）
# 自分の環境に合わせて変更してください（例: 192.168.1.100, 10.0.0.5 など）
# macOS: System Settings > Network > Wi-Fi > Details > TCP/IP > IPv4 Address
# Windows: ipconfig コマンドで確認
VITE_LOCAL_IP_ADDRESS=192.168.x.x
VITE_DEV_PORT=5173

# ローカル開発用のホスト名（.localhostドメインは自動的に127.0.0.1に解決される）
# プロジェクト名を変更する場合はここを編集
VITE_LOCAL_HOSTNAME=queue-app.localhost

# Database Configuration
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE_NAME

# ElectricSQL Configuration
# 自動的に VITE_LOCAL_IP_ADDRESS を使用
# CaddyプロキシでHTTPS化するため、HTTPSとポート番号なしを使用
VITE_ELECTRIC_URL=https://${VITE_LOCAL_IP_ADDRESS}/v1/shape
